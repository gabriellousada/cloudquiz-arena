# ==============================================================================
# CONFIGURAÇÃO DO BACK4APP (BaaS - Parse Platform)
# Copie este arquivo para .env e preencha com as chaves do seu App no Back4App:
# Painel Back4App -> App Settings -> Security & Keys
# ==============================================================================
VITE_BACK4APP_APP_ID=seu_application_id_aqui
VITE_BACK4APP_JS_KEY=sua_javascript_key_aqui
VITE_BACK4APP_REST_KEY=sua_rest_api_key_opcional_aqui
VITE_BACK4APP_SERVER_URL=https://parseapi.back4app.com
VITE_BACK4APP_LIVEQUERY_URL=wss://cloudquiz.b4a.io
