# ==============================================================================
# Back4App (Parse) — Painel: App Settings -> Security & Keys
# Local: copie para .env | Vercel: Settings -> Environment Variables
# ==============================================================================

# --- Usadas pelo frontend (vão para o bundle; são chaves públicas do cliente) ---
VITE_BACK4APP_APP_ID=seu_application_id_aqui
VITE_BACK4APP_JS_KEY=sua_javascript_key_aqui
VITE_BACK4APP_SERVER_URL=https://parseapi.back4app.com
# Opcional (tempo real via WebSocket). Ex: wss://seuapp.b4a.io
VITE_BACK4APP_LIVEQUERY_URL=

# --- Somente para o script "npm run seed" (NÃO cadastre na Vercel) ---
BACK4APP_MASTER_KEY=sua_master_key_aqui
